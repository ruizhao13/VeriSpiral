{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "research_question",
    "claim",
    "assumptions",
    "proof_route",
    "novelty",
    "comparators",
    "expected_value",
    "evidence",
    "semantic_verification",
    "human_acceptance",
    "risks",
    "limitations",
    "reward_questions",
    "skill_blueprint",
    "status"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 8},
    "research_question": {"type": "string", "minLength": 16},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "shape", "measurable_target", "kill_conditions"],
      "properties": {
        "statement": {"type": "string", "minLength": 16},
        "shape": {"type": "string", "minLength": 3},
        "measurable_target": {"type": "string", "minLength": 8},
        "kill_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "classification", "cost", "weakening"],
        "properties": {
          "id": {"type": "string", "minLength": 2},
          "statement": {"type": "string", "minLength": 8},
          "classification": {
            "type": "string",
            "enum": ["structural", "measurement", "computational", "scope", "engineering"]
          },
          "cost": {"type": "string", "minLength": 4},
          "weakening": {"type": "string", "minLength": 4}
        }
      }
    },
    "proof_route": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 8}
    },
    "novelty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "contribution", "collision_status", "coverage"],
      "properties": {
        "scope": {"type": "string", "enum": ["system_demo", "project_level", "field_level"]},
        "contribution": {"type": "string", "minLength": 8},
        "collision_status": {"type": "string", "minLength": 4},
        "coverage": {"type": "string", "minLength": 8}
      }
    },
    "comparators": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "difference", "tradeoff"],
        "properties": {
          "name": {"type": "string", "minLength": 3},
          "difference": {"type": "string", "minLength": 8},
          "tradeoff": {"type": "string", "minLength": 8}
        }
      }
    },
    "expected_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "story", "success_metric"],
      "properties": {
        "audience": {"type": "string", "minLength": 3},
        "story": {"type": "string", "minLength": 8},
        "success_metric": {"type": "string", "minLength": 8}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "locator", "status", "summary"],
        "properties": {
          "id": {"type": "string", "minLength": 2},
          "kind": {"type": "string", "enum": ["artifact", "test", "literature", "human"]},
          "locator": {"type": "string", "minLength": 3},
          "status": {"type": "string", "const": "declared"},
          "summary": {"type": "string", "minLength": 8}
        }
      }
    },
    "semantic_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "receipt_locator"],
      "properties": {
        "status": {"type": "string", "enum": ["pending", "receipt_attached"]},
        "receipt_locator": {"type": "string"}
      }
    },
    "human_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "record_locator"],
      "properties": {
        "status": {"type": "string", "enum": ["pending", "accepted", "rejected"]},
        "record_locator": {"type": "string"}
      }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 8}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 8}
    },
    "reward_questions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 8}
    },
    "skill_blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "trigger",
        "inputs",
        "workflow",
        "outputs",
        "validation",
        "failure_modes"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "description": {"type": "string", "minLength": 16},
        "trigger": {"type": "string", "minLength": 8},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "workflow": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 8}},
        "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "validation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
        "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}}
      }
    },
    "status": {"type": "string", "enum": ["ready_for_verification", "parked"]}
  }
}
