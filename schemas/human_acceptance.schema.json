{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit human acceptance record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance_id",
    "candidate_id",
    "semantic_sha256",
    "skill_blueprint_sha256",
    "verification_receipt",
    "decision",
    "scope",
    "reviewer_role",
    "basis",
    "limitations_acknowledged"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "acceptance_id": {"type": "string", "pattern": "^acceptance-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "skill_blueprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verification_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "sha256"],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^receipt-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "decision": {"type": "string", "enum": ["accepted", "rejected"]},
    "scope": {"type": "string", "const": "prototype_skill_activation"},
    "reviewer_role": {"type": "string", "const": "human_reviewer"},
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 12}
    },
    "limitations_acknowledged": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 12}
    }
  }
}
