{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Induced reusable skill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "description",
    "trigger",
    "inputs",
    "workflow",
    "outputs",
    "validation",
    "failure_modes",
    "activation_status",
    "provenance"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "description": {"type": "string", "minLength": 16},
    "trigger": {"type": "string", "minLength": 8},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "workflow": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "activation_status": {"type": "string", "const": "eligible_for_activation"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "source_packet_id",
        "reward_signal",
        "verification_receipt_id",
        "verification_receipt_sha256",
        "skill_blueprint_sha256",
        "human_acceptance_id",
        "human_acceptance_sha256",
        "acceptance_registry_id",
        "acceptance_registry_sha256"
      ],
      "properties": {
        "trace_id": {"type": "string", "pattern": "^trace-[a-f0-9]{12}$"},
        "source_packet_id": {"type": "string", "pattern": "^packet-[a-f0-9]{12}$"},
        "reward_signal": {"type": "string", "const": "bound_verification_and_human_acceptance"},
        "verification_receipt_id": {"type": "string", "pattern": "^receipt-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "verification_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "skill_blueprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "human_acceptance_id": {"type": "string", "pattern": "^acceptance-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "human_acceptance_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "acceptance_registry_id": {"type": "string", "pattern": "^acceptance-registry-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "acceptance_registry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
