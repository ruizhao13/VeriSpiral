{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registered minimax certificate evolution scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "source_registry",
    "problem_signature",
    "target_assumptions",
    "assumption_order",
    "lower_certificate",
    "rounds"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "scenario_id": {"type": "string", "minLength": 3},
    "source_registry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "url", "locator", "registration_status", "proof_status"],
        "properties": {
          "source_id": {"type": "string", "minLength": 3},
          "title": {"type": "string", "minLength": 8},
          "url": {"type": "string", "pattern": "^https://"},
          "locator": {"type": "string", "minLength": 3},
          "registration_status": {"type": "string", "const": "registered_public_extract"},
          "proof_status": {"type": "string", "const": "cited_not_reproved"}
        }
      }
    },
    "problem_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_model", "parameter_class", "loss", "algorithm_class", "regime"],
      "properties": {
        "observation_model": {"type": "string", "minLength": 3},
        "parameter_class": {"type": "string", "minLength": 3},
        "loss": {"type": "string", "minLength": 3},
        "algorithm_class": {"type": "string", "minLength": 3},
        "regime": {"type": "string", "minLength": 3}
      }
    },
    "target_assumptions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["string", "integer", "boolean"]}
    },
    "assumption_order": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": {"type": ["string", "integer", "boolean"]}
      }
    },
    "lower_certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate_id", "kind", "registered", "source_id", "theorem_locator", "extraction_note", "problem_signature", "assumptions", "rate"],
      "properties": {
        "certificate_id": {"type": "string", "minLength": 3},
        "kind": {"type": "string", "const": "lower"},
        "registered": {"type": "boolean", "const": true},
        "source_id": {"type": "string", "minLength": 3},
        "theorem_locator": {"type": "string", "minLength": 3},
        "extraction_note": {"type": "string", "minLength": 12},
        "problem_signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observation_model", "parameter_class", "loss", "algorithm_class", "regime"],
          "properties": {
            "observation_model": {"type": "string", "minLength": 3},
            "parameter_class": {"type": "string", "minLength": 3},
            "loss": {"type": "string", "minLength": 3},
            "algorithm_class": {"type": "string", "minLength": 3},
            "regime": {"type": "string", "minLength": 3}
          }
        },
        "assumptions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": ["string", "integer", "boolean"]}
        },
        "rate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["polynomial_exponents", "log_exponents"],
          "properties": {
            "polynomial_exponents": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
              "additionalProperties": {
                "type": ["string", "integer"],
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$"
              }
            },
            "log_exponents": {
              "type": "object",
              "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
              "additionalProperties": {
                "type": ["string", "integer"],
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$"
              }
            }
          }
        }
      }
    },
    "rounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "round_index",
          "candidate_id",
          "candidate_label",
          "algorithm_change",
          "search_hypothesis",
          "upper_certificate"
        ],
        "properties": {
          "round_index": {"type": "integer"},
          "candidate_id": {"type": "string", "minLength": 3},
          "candidate_label": {"type": "string", "minLength": 3},
          "algorithm_change": {"type": "string", "minLength": 8},
          "search_hypothesis": {"type": "string", "minLength": 8},
          "upper_certificate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["certificate_id", "kind", "registered", "source_id", "theorem_locator", "extraction_note", "problem_signature", "assumptions", "rate"],
            "properties": {
              "certificate_id": {"type": "string", "minLength": 3},
              "kind": {"type": "string", "const": "upper"},
              "registered": {"type": "boolean", "const": true},
              "source_id": {"type": "string", "minLength": 3},
              "theorem_locator": {"type": "string", "minLength": 3},
              "extraction_note": {"type": "string", "minLength": 12},
              "problem_signature": {
                "type": "object",
                "additionalProperties": false,
                "required": ["observation_model", "parameter_class", "loss", "algorithm_class", "regime"],
                "properties": {
                  "observation_model": {"type": "string", "minLength": 3},
                  "parameter_class": {"type": "string", "minLength": 3},
                  "loss": {"type": "string", "minLength": 3},
                  "algorithm_class": {"type": "string", "minLength": 3},
                  "regime": {"type": "string", "minLength": 3}
                }
              },
              "assumptions": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {"type": ["string", "integer", "boolean"]}
              },
              "rate": {
                "type": "object",
                "additionalProperties": false,
                "required": ["polynomial_exponents", "log_exponents"],
                "properties": {
                  "polynomial_exponents": {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
                    "additionalProperties": {
                      "type": ["string", "integer"],
                      "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$"
                    }
                  },
                  "log_exponents": {
                    "type": "object",
                    "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
                    "additionalProperties": {
                      "type": ["string", "integer"],
                      "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
