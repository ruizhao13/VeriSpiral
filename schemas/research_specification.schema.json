{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned human-governed research specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model",
    "target",
    "assumptions",
    "verifier_suite",
    "human_judgment_boundary",
    "version"
  ],
  "properties": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "research_question", "observation_model", "loss"],
      "properties": {
        "model_id": {"type": "string", "minLength": 3},
        "research_question": {"type": "string", "minLength": 20},
        "observation_model": {"type": "string", "minLength": 10},
        "loss": {"type": "string", "minLength": 10}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "objective", "required_rate_signature"],
      "properties": {
        "target_id": {"type": "string", "minLength": 3},
        "objective": {"type": "string", "minLength": 20},
        "required_rate_signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["polynomial_exponents", "log_exponents"],
          "properties": {
            "polynomial_exponents": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
              "additionalProperties": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$"}
            },
            "log_exponents": {
              "type": "object",
              "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
              "additionalProperties": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$"}
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["string", "integer", "boolean"]}
    },
    "verifier_suite": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verifier_id", "type", "semantic_scope", "limitation"],
        "properties": {
          "verifier_id": {"type": "string", "minLength": 3},
          "type": {
            "type": "string",
            "enum": ["assumption_exact_match", "information_interface_exact_match", "rate_signature_exact_match"]
          },
          "semantic_scope": {"type": "string", "minLength": 20},
          "limitation": {"type": "string", "minLength": 20}
        }
      }
    },
    "human_judgment_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_may_propose", "human_must_decide", "scientific_claim_rule"],
      "properties": {
        "ai_may_propose": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8}
        },
        "human_must_decide": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8}
        },
        "scientific_claim_rule": {"type": "string", "minLength": 30}
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    }
  }
}
